{
  "title": "Kafka",
  "uid": "kafka",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_VICTORIAMETRICS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "VictoriaMetrics", "value": "VictoriaMetrics" },
        "hide": 2
      },
      {
        "name": "consumergroup",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
        "query": "label_values(kafka_consumergroup_lag, consumergroup)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1 Cluster",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Brokers up",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "kafka_brokers",
          "legendFormat": "brokers"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Topics",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "count(count by (topic)(kafka_topic_partitions))",
          "legendFormat": "topics"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Partitions",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum(kafka_topic_partitions)",
          "legendFormat": "partitions"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "2 Lag",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Total lag by group/topic",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (consumergroup, topic)(kafka_consumergroup_lag{consumergroup=~\"$consumergroup\"})",
          "legendFormat": "{{consumergroup}} / {{topic}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top lagging",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "topk(20, kafka_consumergroup_lag{consumergroup=~\"$consumergroup\"})",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["consumergroup", "topic", "partition", "Value"] } } }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Lag over time",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (consumergroup)(kafka_consumergroup_lag{consumergroup=~\"$consumergroup\"})",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "3 Throughput",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Produce rate by topic",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (topic)(rate(kafka_topic_partition_current_offset[5m]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Consume rate by group",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (consumergroup)(rate(kafka_consumergroup_current_offset{consumergroup=~\"$consumergroup\"}[5m]))",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "4 Topic",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Partitions per topic",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "kafka_topic_partitions",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["topic", "Value"] } } }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Retained backlog",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (topic)(kafka_topic_partition_current_offset - kafka_topic_partition_oldest_offset)",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "5 Repl",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Under-replicated",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 53 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum(kafka_topic_partition_under_replicated_partition)",
          "legendFormat": "under-replicated partitions"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "In-sync replicas",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 53 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "kafka_topic_partition_in_sync_replica",
          "legendFormat": "{{topic}} p{{partition}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "text",
      "title": "Replication note",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 61 },
      "options": {
        "mode": "markdown",
        "content": "**RF=1 single broker** — replication metrics are degenerate locally; kept to show what to watch in prod.\n\nIn a production multi-broker cluster:\n- **Under-replicated** should be 0; any spike indicates a broker lagging or down.\n- **In-sync replicas** should equal the replication factor for every partition."
      }
    }
  ]
}
