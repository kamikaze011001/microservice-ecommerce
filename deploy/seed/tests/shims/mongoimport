#!/usr/bin/env python3
"""Fake `mongoimport` — used only by
deploy/seed/tests/fixtures/02-mongo-seed.sh (the /seed-path-parameterised
copy of k8s/infra/jobs/02-mongo-seed/seed.sh), which calls the client bare.

Unlike the docker-wrapped compose case, `--file` here already points at a
real file under $SEED_ROOT (populated by capture-golden.sh), so we just read
it directly — no REPO_ROOT/basename resolution needed.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _lib import load_json_array, log_record, redact_argv  # noqa: E402

LOG = "mongoimport"


def find_after(args, flag):
    if flag in args:
        i = args.index(flag)
        if i + 1 < len(args):
            return args[i + 1]
    return None


def main():
    argv = sys.argv[1:]
    log_record(LOG, {"kind": "raw", "argv": redact_argv(argv)})

    collection = find_after(argv, "--collection")
    file_arg = find_after(argv, "--file")
    if collection and file_arg and os.path.isfile(file_arg):
        docs = load_json_array(file_arg)
        log_record(LOG, {"kind": "mongo_import", "collection": collection, "docs": docs})
    return 0


if __name__ == "__main__":
    sys.exit(main())
