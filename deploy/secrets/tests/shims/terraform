#!/usr/bin/env bash
# Fake `terraform`. seed-secrets.sh calls
#   terraform -chdir="$TF" output -raw <name>
# so the output name is always the LAST argument. Serve it from the fixture,
# which is shaped exactly like real `terraform output -json`.
#
# Real `terraform output -raw` prints the value with NO trailing newline;
# plain `jq -r` appends one. seed-secrets.sh always captures this via
# `$(...)`, which strips trailing newlines anyway, but `-j` (join-output,
# implies raw) matches the real binary's byte-for-byte behaviour so the shim
# is correct even if called outside a command substitution.
set -u

: "${TF_FIXTURE:?TF_FIXTURE must be set}"

name=""
for a in "$@"; do name="$a"; done

jq -ej --arg n "$name" '.[$n].value' "$TF_FIXTURE"
