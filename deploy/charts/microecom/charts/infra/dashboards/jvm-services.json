{
  "title": "JVM (per service)",
  "uid": "jvm-services",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_VICTORIAMETRICS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "VictoriaMetrics", "value": "VictoriaMetrics" },
        "hide": 2
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
        "query": "label_values(jvm_memory_used_bytes, app)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
        "query": "label_values(jvm_memory_used_bytes{app=~\"$service\"}, pod)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1 Alive",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Instances up",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "count(up{job=\"spring-actuator\", app=~\"$service\"})",
          "legendFormat": "instances"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "process_uptime_seconds{app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "{{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Restarts (1h)",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"apps\", pod=~\"$pod\"}[1h])",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Process CPU",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "process_cpu_usage{app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "{{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "2 CPU",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM vs system CPU",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "process_cpu_usage{app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "process {{app}} / {{pod}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "system_cpu_usage{app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "system {{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Load avg ÷ cores",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "system_load_average_1m{app=~\"$service\", pod=~\"$pod\"} / system_cpu_count{app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "{{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "3a Mem",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Heap used vs max",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (pod)(jvm_memory_used_bytes{area=\"heap\", app=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "used {{pod}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "jvm_memory_max_bytes{area=\"heap\", app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "max {{pod}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Non-heap / Metaspace",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "jvm_memory_used_bytes{area=\"nonheap\", app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "{{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "3b Gen",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Eden occupancy",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "jvm_memory_used_bytes{app=~\"$service\", pod=~\"$pod\", id=~\".*Eden.*\"}",
          "legendFormat": "{{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Survivor occupancy",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "jvm_memory_used_bytes{app=~\"$service\", pod=~\"$pod\", id=~\".*Survivor.*\"}",
          "legendFormat": "{{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Old gen occupancy",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "jvm_memory_used_bytes{app=~\"$service\", pod=~\"$pod\", id=~\".*Old.*|.*Tenured.*\"}",
          "legendFormat": "{{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Allocation rate",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "rate(jvm_gc_memory_allocated_bytes_total{app=~\"$service\", pod=~\"$pod\"}[5m])",
          "legendFormat": "{{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Promotion rate (young→Old)",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 52 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "rate(jvm_gc_memory_promoted_bytes_total{app=~\"$service\", pod=~\"$pod\"}[5m])",
          "legendFormat": "{{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "row",
      "title": "4 GC",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 60 }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "GC pause rate by action",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "rate(jvm_gc_pause_seconds_count{app=~\"$service\", pod=~\"$pod\"}[5m])",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "GC avg pause",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "rate(jvm_gc_pause_seconds_sum{app=~\"$service\", pod=~\"$pod\"}[5m]) / rate(jvm_gc_pause_seconds_count{app=~\"$service\", pod=~\"$pod\"}[5m])",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "GC max pause",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 69 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "jvm_gc_pause_seconds_max{app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "row",
      "title": "5 Threads",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 77 }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Live / daemon / peak",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 78 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "jvm_threads_live_threads{app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "live {{app}} / {{pod}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "jvm_threads_daemon_threads{app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "daemon {{app}} / {{pod}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "jvm_threads_peak_threads{app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "peak {{app}} / {{pod}}"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Thread states",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 78 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "jvm_threads_states_threads{app=~\"$service\", pod=~\"$pod\"}",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 25,
      "type": "row",
      "title": "6 HTTP",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 86 }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Request rate by status",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 87 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (status)(rate(http_server_requests_seconds_count{app=~\"$service\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Error ratio (5xx)",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 87 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum(rate(http_server_requests_seconds_count{app=~\"$service\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{app=~\"$service\"}[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Latency p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 95 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "histogram_quantile(0.95, sum by (le)(rate(http_server_requests_seconds_bucket{app=~\"$service\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "histogram_quantile(0.99, sum by (le)(rate(http_server_requests_seconds_bucket{app=~\"$service\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
