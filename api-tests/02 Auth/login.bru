meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/authorization-server/v1/auth:login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{user}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  // Every later request authenticates with this.
  bru.setVar("accessToken", res.getBody().data.access_token);
}

tests {
  test("returns an RS256 JWT access token", function () {
    const token = res.getBody().data.access_token;
    expect(token.split(".")).to.have.length(3);
    const header = JSON.parse(Buffer.from(token.split(".")[0], "base64").toString());
    expect(header.alg).to.equal("RS256");
  });
}
