meta {
  name: protected route without a token → 401
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/bff-service/v1/cart
  body: none
  auth: none
}

tests {
  test("401 auth.token_missing", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().data.code).to.equal("auth.token_missing");
  });
}
