meta {
  name: wrong password → 400
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/authorization-server/v1/auth:login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{user}}",
    "password": "Wrong@123456"
  }
}

tests {
  // Pins TODAY's contract: 400 (not 401), and the sentence doubles as the
  // `code`. Changing that is a product decision — this test makes it visible.
  test("400 with 'Your password is incorrect'", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().data.message).to.equal("Your password is incorrect");
  });
  test("no token is issued", function () {
    expect(JSON.stringify(res.getBody())).to.not.include("access_token");
  });
}
