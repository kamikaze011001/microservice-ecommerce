# macOS finder junk
.DS_Store

# Superpowers SDD scratch (progress ledger, task briefs) — never commit
.superpowers/

# Local deploy runtime state
deploy/.run/

# Helm vendored subchart tarballs — rebuilt from Chart.lock by `helm dependency build`
deploy/charts/microecom/charts/infra/charts/

# Python bytecode — deploy/scripts/lib/ is imported by the secrets tooling
__pycache__/
*.pyc
