<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.6</version>
        <relativePath/>
    </parent>
    <groupId>org.aibles.ecommerce</groupId>
    <artifactId>core-s3</artifactId>
    <version>0.0.1</version>
    <name>core-s3</name>
    <description>S3-compatible object storage abstraction for the ecommerce platform</description>
    <properties>
        <java.version>17</java.version>
        <aws.sdk.version>2.28.16</aws.sdk.version>
        <testcontainers.version>1.20.4</testcontainers.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>
        <!-- STS module: required for IRSA on EKS. DefaultCredentialsProvider's
             WebIdentityTokenCredentialsProvider calls AssumeRoleWithWebIdentity
             to exchange the pod's projected SA token for the IAM role's temp
             creds. AWS SDK v2 is intentionally modular — the `s3` artifact does
             NOT pull `sts` in transitively — so without this on the classpath the
             SDK logs "To use web identity tokens, the 'sts' service module must
             be on the class path", IRSA fails silently, and the credential chain
             falls back to the EKS NODE's instance profile (IMDS). That node role
             has no s3:PutObject on the media bucket → every presigned-upload PUT
             returns 403 AccessDenied (the presign itself succeeds because it
             signs with whatever creds it resolved, and the URL even carries an
             X-Amz-Security-Token, so it looks like IRSA worked). Both
             authorization-server (avatars) and product-service (product images)
             depend on core-s3, so they pick STS up transitively. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>minio</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
